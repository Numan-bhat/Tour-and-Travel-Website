# Generate a long random value for production. Never commit the real value.
APP_ENV=production
SECRET_KEY=replace-with-a-random-64-character-value
ADMIN_USERNAME=replace-with-a-private-admin-name
# Preferred: a Werkzeug password hash generated with generate_password_hash().
ADMIN_PASSWORD_HASH=replace-with-a-password-hash
# Development only. Production always requires ADMIN_PASSWORD_HASH instead.
ADMIN_PASSWORD=change-me-local-only
COOKIE_SECURE=1
FLASK_DEBUG=0

# Managed PostgreSQL: set this to the connection URL supplied by your host.
# Leave blank only when using a mounted persistent SQLite volume.
DATABASE_URL=

# Email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL=

# Quotation PDFs: path to Chrome/Chromium/Edge if it is not found automatically.
CHROME_PATH=

# Optional integrations
GOOGLE_ANALYTICS_ID=
GOOGLE_MAPS_EMBED_URL=
GOOGLE_REVIEWS_URL=
GOOGLE_SITE_VERIFICATION=
PAYMENT_URL=
BUSINESS_REGISTRATION=
